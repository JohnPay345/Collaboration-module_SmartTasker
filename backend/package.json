{
  "name": "app_api",
  "author": "Ainur",
  "version": "0.0.1",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "dotenv -e .env.production -v NODE_ENV=production node dist/index.js",
    "dev": "dotenv -e .env.development -v NODE_ENV=development nodemon app.js",
    "build:dev": "dotenv -e .env.development -v NODE_ENV=development webpack --config webpack.config.cjs",
    "build:prod": "dotenv -e .env.production -v NODE_ENV=production webpack --config webpack.config.cjs",
    "clean": "rimraf dist",
    "test:collab": "node scripts/colleagueBots.js collab",
    "test:collab-load": "node scripts/colleagueBots.js collab-load",
    "test:chat": "node scripts/colleagueBots.js chat",
    "test:chat-load": "node scripts/colleagueBots.js chat-load"
  },
  "dependencies": {
    "@dicebear/collection": "^9.2.2",
    "@dicebear/core": "^9.2.2",
    "@dicebear/initials": "^9.2.2",
    "@fastify/cors": "^8.0.0",
    "@fastify/multipart": "^7.0.0",
    "@fastify/static": "^6.0.0",
    "amqplib": "^0.10.8",
    "bcrypt": "^5.0.0",
    "dotenv": "^16.0.0",
    "fastify": "^4.0.0",
    "fastify-multer": "^2.0.3",
    "fastify-plugin": "^5.0.1",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.0",
    "mathjs": "^14.5.2",
    "pg": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "redis": "^5.12.1",
    "ws": "^8.18.2",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "dotenv-cli": "^11.0.0",
    "dotenv-webpack": "^8.0.1",
    "nodemon": "^3.0.0",
    "rimraf": "^5.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "imports": {
    "#root/*": "./*",
    "#rmq/*": "./rabbitmq/*",
    "#controllers/*": "./controllers/*",
    "#routes/*": "./routes/*",
    "#models/*": "./models/*"
  }
}
