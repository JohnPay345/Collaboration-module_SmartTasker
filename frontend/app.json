{
  "expo": {
    "name": "SmartTasker",
    "slug": "smarttasker_frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logos/icon.png",
    "scheme": "smarttasker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gregory12.smarttasker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logos/android-icon.png",
        "backgroundColor": "#2183f2"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gregory12.smarttasker",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/logos/web-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logos/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "662adff6-65e7-45fe-aabd-ea20bf5a5100"
      }
    }
  }
}
